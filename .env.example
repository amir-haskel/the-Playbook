# OpsPulse configuration. Copy to .env for local dev; in OpenShift these come
# from a Secret (see openshift/secret.yaml).

# --- Admin auth (required to use /admin) ---
ADMIN_PASSWORD=changeme

# --- Session cookie signing (set a stable random value in prod) ---
# SESSION_SECRET=replace-with-a-long-random-string

# --- Filesystem ---
# Local dev defaults: ./data and ./scripts. In the container these are
# /data (PVC) and /scripts (image or mount).
DATA_DIR=./data
SCRIPTS_DIR=./scripts

# --- External APIs (used ONLY for dynamic dropdowns) ---
GITLAB_API_URL=https://gitlab.example.com/api/v4
GITLAB_TOKEN=
OPENSHIFT_API_URL=https://api.openshift.example.com:6443
OPENSHIFT_TOKEN=

# HTTP_TIMEOUT=15
