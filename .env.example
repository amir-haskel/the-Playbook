# The Playbook configuration. Copy to .env for local dev; in Kubernetes/OpenShift these come
# from a Secret (see the Helm chart: deploy/helm/playbook).

# --- Admin auth (required to use /admin) ---
ADMIN_PASSWORD=changeme

# --- Session cookie signing (set a stable random value in prod) ---
# SESSION_SECRET=replace-with-a-long-random-string

# --- Filesystem ---
# Local dev defaults: ./data and the chart's bundled scripts. In the cluster
# SCRIPTS_DIR is /scripts (the scripts ConfigMap mounted by the Helm chart).
DATA_DIR=./data
SCRIPTS_DIR=./charts/playbook/scripts
# Storage is split across two independently-mountable volumes; each defaults to
# a subdir of DATA_DIR so local dev needs nothing extra. In the cluster, point
# each at its own PVC mount (the Helm chart does this):
#   DB_DIR    -> the SQLite database (+ its WAL/SHM sidecars)
#   STORE_DIR -> execution history outputs + upload staging
# DB_DIR=/data/db
# STORE_DIR=/data/store

# --- External APIs (used ONLY for dynamic dropdowns) ---
GITLAB_API_URL=https://gitlab.example.com/api/v4
GITLAB_TOKEN=
OPENSHIFT_API_URL=https://api.openshift.example.com:6443
OPENSHIFT_TOKEN=

# HTTP_TIMEOUT=15
